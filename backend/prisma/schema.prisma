// This is your Prisma schema file

generator client {
  provider      = "prisma-client-js"
  // Tell Prisma to generate engine binaries for:
  //  - "native"                    → local Windows dev machine
  //  - "linux-musl-openssl-3.0.x" → Alpine Linux (Docker) with OpenSSL 3.x
  // Without this, Prisma downloads the OpenSSL 1.1 engine binary which
  // doesn't work on Alpine 3.18+ (which ships OpenSSL 3 only).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Use an enum to manage the various states of an Incident
enum IncidentStatus {
  OPEN
  ACCEPTED
  REJECTED
  INVESTIGATING
  PENDING_ACTION
  UNDER_REVIEW
  CLOSED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Role {
  ADMIN
  MANAGER
  INVESTIGATOR
  ACTION_OWNER
  STAFF
}

enum AiModelStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DEPLOYED
  REJECTED
  RETIRED
  ROLLED_BACK
}

enum InvestigationReviewStatus {
  NOT_SUBMITTED
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

enum ActionType {
  IMMEDIATE
  CORRECTIVE
  PREVENTIVE
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionReviewStatus {
  ACTIVE
  RETURNED_FOR_REVISION
  COMPLETED_PENDING_VERIFICATION
  VERIFIED
}

enum ActionEffectiveness {
  NOT_ASSESSED
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  INEFFECTIVE
}

enum ActionNotificationType {
  DUE_SOON
  OVERDUE
  ESCALATION
  RETURNED
  VERIFIED
}

enum ControlEffectiveness {
  NOT_TESTED
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  INEFFECTIVE
}

enum ReviewOutcome {
  APPROVED
  REVISION_REQUIRED
}

enum DisseminationStatus {
  NOT_SCHEDULED
  SCHEDULED
  COMPLETED
}

enum InvestigationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

enum InvestigationMethod {
  FIVE_WHYS
  FISHBONE
  FAULT_TREE
  TIMELINE_ANALYSIS
  OTHER
}

enum AiFeedbackAction {
  ACCEPTED
  DISMISSED
  OVERRIDDEN
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  password      String
  name          String
  role          Role       @default(STAFF)
  departmentId  Int
  department    Department @relation(fields: [departmentId], references: [id])
  isActive      Boolean    @default(true)
  deactivatedAt DateTime?

  // 2. Use relation names because a single User can have multiple relationships
  reportedIncidents     Incident[]           @relation("Reporter")
  investigatedIncidents Incident[]           @relation("Investigator")
  ownedActions          Incident[]           @relation("ActionOwner")
  auditLogs             AuditLog[]           @relation("AuditActor")
  incidentCorrections   IncidentCorrection[] @relation("CorrectionActor")
  managerActionItems    CorrectiveActionItem[] @relation("ActionItemOwner")
  managedControls       ControlAssessment[]   @relation("ControlOwner")
  managementReviews     ManagementReview[]    @relation("ReviewManager")
  ledInvestigations     Investigation[]       @relation("LeadInvestigator")
  investigationTeams    InvestigationTeamMember[]
  actionHistory         ActionHistory[]
  actionNotifications   ActionNotification[]
  actionAiFeedback      ActionAiFeedback[]
  staffDraft            StaffIncidentDraft?
  staffAiFeedback       StaffAiFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  isActive    Boolean    @default(true)
  users       User[]
  incidents   Incident[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Incident {
  id              Int            @id @default(autoincrement())
  referenceId     String?         @unique
  title           String
  description     String
  severity        Severity
  category        String
  location        String
  status          IncidentStatus @default(OPEN)
  rejectionReason String? // Value provided only if rejected (optional)
  occurrenceAt    DateTime?
  reportedAt      DateTime        @default(now())
  subcategory     String?
  managerDecisionType String?
  managerDecisionAt   DateTime?
  revisionFields      String[]    @default([])
  staffRevisionNumber Int         @default(0)

  // Root Cause Analysis (Feature 4)
  rootCause         String? @map("root_cause")
  rootCauseCategory String? @map("root_cause_category")

  correctiveAction String?

  managerDecisionComment    String?
  investigationReviewStatus InvestigationReviewStatus @default(NOT_SUBMITTED)
  investigationReviewComment String?
  originalSeverity          Severity?
  riskScore                 Float?
  riskLevel                 String?
  riskExplanation           Json?
  riskOverride              String?
  riskOverrideReason        String?
  closureSummary            String?
  closedAt                  DateTime?
  reopenReason              String?
  reopenedAt                DateTime?
  reopenCount               Int       @default(0)

  // 3. Foreign keys and relationships
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  reporterId Int
  reporter   User @relation("Reporter", fields: [reporterId], references: [id])

  investigatorId Int? // Optional because not assigned initially
  investigator   User? @relation("Investigator", fields: [investigatorId], references: [id])

  actionOwnerId Int? // Optional because not assigned initially
  actionOwner   User? @relation("ActionOwner", fields: [actionOwnerId], references: [id])

  // File attachments (Kasun's feature)
  attachments IncidentAttachment[]
  corrections IncidentCorrection[]
  actionItems CorrectiveActionItem[]
  controls    ControlAssessment[]
  reviews     ManagementReview[]
  lessons     LessonDissemination[]
  investigationRecord Investigation?
  relatedIncidentLinks IncidentRelationship[] @relation("RelatedIncidentSource")
  relatedFromIncidents IncidentRelationship[] @relation("RelatedIncidentTarget")
  staffVersions       StaffIncidentVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffIncidentDraft {
  id           Int      @id @default(autoincrement())
  reporterId   Int      @unique
  reporter     User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  title        String?
  description  String?
  severity     Severity?
  category     String?
  subcategory  String?
  location     String?
  departmentId Int?
  occurrenceAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StaffIncidentVersion {
  id           Int      @id @default(autoincrement())
  incidentId   Int
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json
  changeReason String?
  createdAt    DateTime @default(now())

  @@unique([incidentId, version])
  @@index([incidentId, createdAt])
}

model StaffAiFeedback {
  id         Int              @id @default(autoincrement())
  reporterId Int
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  feature    String
  suggestion Json
  action     AiFeedbackAction
  reason     String?
  createdAt  DateTime         @default(now())

  @@index([reporterId, feature, createdAt])
}

model Investigation {
  id                    Int                 @id @default(autoincrement())
  incidentId            Int                 @unique
  incident              Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  leadInvestigatorId    Int
  leadInvestigator      User                @relation("LeadInvestigator", fields: [leadInvestigatorId], references: [id])
  status                InvestigationStatus @default(DRAFT)
  startDate             DateTime?
  endDate               DateTime?
  method                InvestigationMethod?
  methodOther           String?
  findingsSummary       String?
  rootCauseCategory     String?
  rootCauseSubcategory  String?
  rootCauseDescription  String?
  rootCauseMethod        InvestigationMethod?
  rootCauseDetail        String?
  systemicIssue         Boolean             @default(false)
  revisionNumber        Int                 @default(1)
  submittedAt           DateTime?
  approvedAt            DateTime?
  lockedAt              DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  teamMembers           InvestigationTeamMember[]
  contributingFactors   InvestigationFactor[]
  witnesses             InvestigationWitness[]
  timeline              InvestigationTimelineEvent[]
  evidence              InvestigationEvidence[]
  aiFeedback            InvestigationAiFeedback[]

  @@index([leadInvestigatorId, status])
  @@index([startDate, endDate])
}

model InvestigationTeamMember {
  investigationId Int
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String        @default("TEAM_MEMBER")
  addedAt         DateTime      @default(now())

  @@id([investigationId, userId])
  @@index([userId])
}

model InvestigationFactor {
  id              Int           @id @default(autoincrement())
  investigationId Int
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  category        String
  description     String
  createdAt       DateTime      @default(now())

  @@index([investigationId])
}

model InvestigationWitness {
  id              Int           @id @default(autoincrement())
  investigationId Int
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  name            String
  roleOrContact   String?
  statement       String?
  interviewedAt   DateTime?
  createdAt       DateTime      @default(now())

  @@index([investigationId])
}

model InvestigationTimelineEvent {
  id              Int           @id @default(autoincrement())
  investigationId Int
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  occurredAt      DateTime
  title           String
  description     String
  source          String?
  createdAt       DateTime      @default(now())

  @@index([investigationId, occurredAt])
}

model InvestigationEvidence {
  id              Int           @id @default(autoincrement())
  investigationId Int
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  attachmentId    Int?
  label           String
  reference       String?
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([investigationId])
}

model IncidentRelationship {
  id               Int      @id @default(autoincrement())
  sourceIncidentId Int
  sourceIncident   Incident @relation("RelatedIncidentSource", fields: [sourceIncidentId], references: [id], onDelete: Cascade)
  targetIncidentId Int
  targetIncident   Incident @relation("RelatedIncidentTarget", fields: [targetIncidentId], references: [id], onDelete: Cascade)
  reason           String
  createdAt        DateTime @default(now())

  @@unique([sourceIncidentId, targetIncidentId])
  @@index([targetIncidentId])
}

model InvestigationAiFeedback {
  id              Int              @id @default(autoincrement())
  investigationId Int
  investigation   Investigation    @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  feature         String
  resultKey       String
  action          AiFeedbackAction
  reason          String?
  modelVersion    String
  createdAt       DateTime         @default(now())

  @@index([investigationId, feature])
}

model CorrectiveActionItem {
  id               Int              @id @default(autoincrement())
  incidentId       Int
  incident         Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  title            String
  description      String
  type             ActionType
  priority         ActionPriority   @default(MEDIUM)
  status           ActionItemStatus @default(OPEN)
  ownerId          Int
  owner            User             @relation("ActionItemOwner", fields: [ownerId], references: [id])
  dueDate          DateTime
  escalationReason String?
  progressNote     String?
  verificationNotes String?
  effectiveness   ActionEffectiveness @default(NOT_ASSESSED)
  reviewStatus     ActionReviewStatus  @default(ACTIVE)
  managerReviewComment String?
  returnedAt       DateTime?
  verifiedAt       DateTime?
  effectivenessScore Float?
  completionRiskScore Float?
  riskExplanation Json?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  evidence         ActionEvidence[]
  history          ActionHistory[]
  notifications    ActionNotification[]
  aiFeedback       ActionAiFeedback[]

  @@index([incidentId])
  @@index([ownerId, status])
  @@index([dueDate, status])
}

model ActionEvidence {
  id         Int                  @id @default(autoincrement())
  actionId   Int
  action     CorrectiveActionItem @relation(fields: [actionId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  fileType   String
  fileSize   Int
  uploadedAt DateTime             @default(now())

  @@index([actionId, uploadedAt])
}

model ActionHistory {
  id         Int                  @id @default(autoincrement())
  actionId   Int
  action     CorrectiveActionItem @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actorId    Int?
  actor      User?                @relation(fields: [actorId], references: [id])
  actorRole  Role?
  eventType  String
  fromStatus ActionItemStatus?
  toStatus   ActionItemStatus?
  note       String?
  metadata   Json?
  createdAt  DateTime             @default(now())

  @@index([actionId, createdAt])
}

model ActionNotification {
  id        Int                    @id @default(autoincrement())
  actionId  Int
  action    CorrectiveActionItem   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  userId    Int
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ActionNotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime               @default(now())

  @@unique([actionId, userId, type])
  @@index([userId, readAt, createdAt])
}

model ActionAiFeedback {
  id           Int                  @id @default(autoincrement())
  actionId     Int
  action       CorrectiveActionItem @relation(fields: [actionId], references: [id], onDelete: Cascade)
  userId       Int
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  resultKey    String
  actionTaken  AiFeedbackAction
  reason       String?
  modelVersion String
  createdAt    DateTime             @default(now())

  @@index([actionId, feature])
}

model ControlAssessment {
  id              Int                  @id @default(autoincrement())
  incidentId      Int
  incident        Incident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  controlType     String
  effectiveness   ControlEffectiveness @default(NOT_TESTED)
  failureReason   String?
  improvementPlan String?
  ownerId         Int?
  owner           User?                @relation("ControlOwner", fields: [ownerId], references: [id])
  dueDate         DateTime?
  status          String               @default("PLANNED")
  verifiedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([incidentId])
}

model ManagementReview {
  id              Int           @id @default(autoincrement())
  incidentId      Int
  incident        Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  reviewerId      Int
  reviewer        User          @relation("ReviewManager", fields: [reviewerId], references: [id])
  outcome         ReviewOutcome
  comments        String
  lessonsLearned  String?
  followUpDetails String?
  reviewedAt      DateTime      @default(now())

  @@index([incidentId, reviewedAt])
}

model LessonDissemination {
  id           Int                 @id @default(autoincrement())
  incidentId   Int
  incident     Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  audience     String
  scheduledFor DateTime?
  status       DisseminationStatus @default(NOT_SCHEDULED)
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([incidentId])
}

model IncidentAttachment {
  id       Int    @id @default(autoincrement())
  fileName String
  filePath String
  fileType String

  incidentId Int
  incident   Incident @relation(fields: [incidentId], references: [id])

  uploadedAt DateTime @default(now())
}

model IncidentCorrection {
  id         Int      @id @default(autoincrement())
  incidentId Int
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actorId    Int
  actor      User     @relation("CorrectionActor", fields: [actorId], references: [id])
  reason     String
  before     Json
  after      Json
  createdAt  DateTime @default(now())
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  actorId      Int?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail   String?
  actorRole    Role?
  eventType    String
  action       String
  entityType   String
  entityId     String?
  departmentId Int?
  before       Json?
  after        Json?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([departmentId])
  @@index([eventType])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  category    String
  value       Json
  description String?
  isActive    Boolean  @default(true)
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiModelVersion {
  id                Int           @id @default(autoincrement())
  modelName         String
  version           String
  datasetVersion    String
  trainingDate      DateTime
  metrics           Json?
  status            AiModelStatus @default(DRAFT)
  accuracy          Float?
  driftScore        Float?
  latencyMs         Float?
  deploymentHistory Json?
  isActive          Boolean       @default(false)
  createdById       Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([modelName, version])
  @@index([status])
}
